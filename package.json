{
  "name": "wordloom-vr",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "拾径（Wordloom）— Pico Neo3 WebXR 词图漫游：在词与线的星座间行走，抵达 1024",
  "author": "ZhaoZehao10 (https://github.com/ZhaoZehao10)",
  "license": "MIT",
  "homepage": "https://github.com/ZhaoZehao10/wordloom",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZhaoZehao10/wordloom.git"
  },
  "bugs": {
    "url": "https://github.com/ZhaoZehao10/wordloom/issues"
  },
  "scripts": {
    "serve": "node server.mjs",
    "test": "node tools/test-all.mjs",
    "test:fast": "node tools/test-all.mjs --fast",
    "test:unit": "node test/rw-unit.mjs",
    "test:e2e": "node test/rw-e2e.mjs",
    "test:offline": "node test/rw-offline-e2e.mjs",
    "test:perf": "node test/rw-perf.mjs",
    "build:offline": "node tools/make-offline.mjs",
    "build:icons": "node tools/make-icons.mjs",
    "report:perf": "node tools/perf-report.mjs",
    "report:perf:open": "node tools/perf-report.mjs && start dist/perf-report.html",
    "build:apk": "powershell -ExecutionPolicy Bypass -File tools/build-apk.ps1",
    "build": "node tools/make-offline.mjs && powershell -ExecutionPolicy Bypass -File tools/build-apk.ps1"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "webxr",
    "vr",
    "pico",
    "pico-neo3",
    "three.js",
    "game",
    "word-graph",
    "random-walk"
  ]
}
