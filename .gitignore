# 构建产物（可随时用脚本重新生成）
dist/
apk/build/

# 第三方 Android SDK（数 GB，可用 sdkmanager 重装；README 有步骤）
android-sdk/

# 本地开发证书（node make-cert.mjs 可重新生成，私钥不入库）
cert/

# 本地签名密钥与密码
*.keystore

# 测试日志
test/*.log

# 依赖与临时文件
node_modules/
*.tmp
.DS_Store
Thumbs.db

# 测试产物（每次跑测试重新生成，不入库）
test/*.png
*.idsig

# 临时诊断产物
test/_*
